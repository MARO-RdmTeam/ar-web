rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. إعدادات الموقع العامة: أي زائر يمكنه القراءة، والتعديل فقط للمدير المسجل
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 2. قائمة وتفاصيل الألعاب المعربة: أي زائر يمكنه التصفح، والإضافة/التعديل/الحذف فقط للمدير
    match /games/{gameId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
  }
}

